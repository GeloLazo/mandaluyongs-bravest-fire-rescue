[sub_resource type="GDScript" id="GDScript_dn4c7"]
script/source = "extends CharacterBody2D

const SPEED = 300.0
const JUMP_VELOCITY = -750.0
@onready var sprite_2d: AnimatedSprite2D = $Sprite2D

# I-load ang scene ng tubig
var water_bullet_scene = preload(\"res://waterbullet.tscn\")

func _physics_process(delta: float) -> void:
	# --- SHOOTING ---
	if Input.is_action_just_pressed(\"click\"):
		shoot()
	
	# --- GRAVITY & JUMP ---
	if not is_on_floor():
		velocity += get_gravity() * delta
		sprite_2d.animation = \"jumping\"
	
	if Input.is_action_just_pressed(\"ui_accept\") and is_on_floor():
		velocity.y = JUMP_VELOCITY

	# --- MOVEMENT ---
	var direction := Input.get_axis(\"ui_left\", \"ui_right\")
	if direction:
		velocity.x = direction * SPEED
		sprite_2d.animation = \"running\"
		
		# DITO ANG AYOS: Lilingon siya base sa nilalakaran (direction)
		if direction < 0:
			sprite_2d.flip_h = true  # Pag kaliwa, i-flip
		else:
			sprite_2d.flip_h = false # Pag kanan, balik sa normal
	else:
		velocity.x = move_toward(velocity.x, 0, 12)
		if is_on_floor():
			sprite_2d.animation = \"default\"

	move_and_slide()

# --- SHOOT FUNCTION ---
func shoot():
	var bullet = water_bullet_scene.instantiate()
	get_tree().root.add_child(bullet)
	
	# Ilabas ang tubig sa tapat ng robot (sa bandang dibdib)
	bullet.global_position = global_position + Vector2(0, -20)
	
	# Ituturo ang bala kung nasaan ang Mouse Cursor
	bullet.look_at(get_global_mouse_position())
"

